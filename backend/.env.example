PORT=8000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/automate_ai?retryWrites=true&w=majority
MONGODB_DB_NAME=automate_ai

# Security & Session
JWT_SECRET=your_super_secret_jwt_key
ENCRYPTION_KEY=64_character_hex_string_for_aes_256_gcm
OAUTH_STATE_SECRET=your_oauth_state_secret
SOCIAL_TOKEN_ENCRYPTION_KEY=64_character_hex_string_for_aes_256_gcm
AUTOMATE_MCP_SECRET=your_mcp_jwt_signing_secret

# LLM & Vision (Google Gemini)
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash
TAVILY_API_KEY=your_tavily_api_key

# Google OAuth (Gmail & Google Calendar)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Instagram OAuth & Graph API
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_APP_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/integrations/instagram/callback
INSTAGRAM_GRAPH_VERSION=v23.0
INSTAGRAM_API_VERSION=v26.0
INSTAGRAM_ACCESS_TOKEN=your_page_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_CONFIG_ID=your_instagram_config_id

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_PLAN_100_AMOUNT_PAISE=10000
RAZORPAY_PLAN_500_AMOUNT_PAISE=40000
RAZORPAY_PLAN_2000_AMOUNT_PAISE=100000

# Usage & Credits
CHAT_CREDIT_COST=10

